# ===== LangSmith 追踪（可选，不填则关闭追踪）=====
LANGSMITH_PROJECT=rag-research-agent
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# ===== 语言模型（智谱 GLM，走 OpenAI 兼容端点）=====
# 同时用于对话模型与 cross-encoder 重排
GLM_API_KEY=

# ===== 嵌入模型（硅基流动 BGE-M3，1024 维稠密向量）=====
SiliconEmbedding_API_KEY=
# 可选：自建/代理端点，默认 https://api.siliconflow.cn/v1
# SILICONFLOW_BASE_URL=

# ===== 向量库（Zilliz Cloud / Milvus）=====
Mivilus_URL=
Mivilus_API_KEY=
# 可选：collection 名称，默认 enterprise_knowledge
# MIVILUS_COLLECTION=

# ===== 三层路由第三层：JEV 决策模型 =====
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
# 可选：决策接口路径，默认 /systemone
# JEV_DECIDE_PATH=

# ===== Postgres 记忆（短期会话历史 + 长期记忆，需 pgvector）=====
# 连接串格式：postgresql://<user>:<password>@localhost:5433/rag_memory
POSTGRES_URI=
# docker compose 读取下面三个变量，需与 POSTGRES_URI 中的账号/密码/库名一致
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_memory
